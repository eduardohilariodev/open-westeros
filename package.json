{
  "name": "open-westeros",
  "version": "1.0.0",
  "description": "Community-built, Google Earth-style 3D atlas of the Known World",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "tsc && vite build",
    "plan": "node tools/sites/kingsLanding/plan.mjs",
    "analyze": "node tools/sites/kingsLanding/analyze.mjs",
    "gis": "node tools/sites/kingsLanding/export-gis.mjs",
    "assets": "node tools/world/consensus.mjs && node tools/sites/kingsLanding/plan.mjs && node tools/sites/kingsLanding/analyze.mjs && node tools/sites/kingsLanding/export-gis.mjs",
    "places": "node tools/world/consensus.mjs",
    "winterfell:collect": "node tools/sites/winterfell/collect.mjs",
    "winterfell": "node tools/sites/winterfell/import.mjs",
    "relief": "node tools/world/relief-bake.mjs",
    "wiki": "node tools/wiki/scrape.mjs --places && node tools/wiki/place-info.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/three": "^0.186.0",
    "lz4js": "^0.2.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.186.1"
  }
}
